{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "WorkflowExecuteResult",
  "description": "Result of [`METHOD_WORKFLOW_EXECUTE`].",
  "type": "object",
  "properties": {
    "execution_cwd": {
      "description": "Working directory used for phases.",
      "type": "string"
    },
    "execution_fence": {
      "description": "Echo of the validated execution fence. A parent uses this to ensure the\nterminal result and publication receipt belong to the leased generation.",
      "anyOf": [
        {
          "$ref": "#/$defs/ExecutionFence"
        },
        {
          "type": "null"
        }
      ]
    },
    "phase_events": {
      "description": "Phase events emitted during execution (replaces in-process callback).",
      "type": "array",
      "default": [],
      "items": {
        "$ref": "#/$defs/PhaseEvent"
      }
    },
    "phase_results": {
      "description": "Per-phase results.",
      "type": "array",
      "items": {
        "$ref": "#/$defs/PhaseResultSnapshot"
      }
    },
    "phases_completed": {
      "description": "Number of phases completed.",
      "type": "integer",
      "format": "uint",
      "minimum": 0
    },
    "phases_requested": {
      "description": "Phase ids that were requested by this run.",
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "phases_total": {
      "description": "Total phases in the workflow.",
      "type": "integer",
      "format": "uint",
      "minimum": 0
    },
    "post_success": {
      "description": "Legacy opaque post-success action outcome. New publication-aware\nconsumers use [`Self::publication_receipt`] instead."
    },
    "publication_receipt": {
      "description": "Typed, versioned publication proof. Required by the host before it marks\na workflow with `publication.required=true` completed.",
      "anyOf": [
        {
          "$ref": "#/$defs/PublicationReceipt"
        },
        {
          "type": "null"
        }
      ]
    },
    "subject_id": {
      "description": "Subject id this run targeted.",
      "type": "string"
    },
    "success": {
      "description": "True iff `workflow_status == COMPLETED`.",
      "type": "boolean"
    },
    "total_duration_secs": {
      "description": "Total wall-clock duration.",
      "type": "integer",
      "format": "uint64",
      "minimum": 0
    },
    "workflow_id": {
      "description": "Unique workflow id (echoed on resume or freshly allocated on start).",
      "type": "string"
    },
    "workflow_ref": {
      "description": "Resolved workflow ref.",
      "type": "string"
    },
    "workflow_status": {
      "description": "Final status; one of [`workflow_status`] values.",
      "type": "string"
    }
  },
  "required": [
    "workflow_id",
    "workflow_ref",
    "workflow_status",
    "subject_id",
    "execution_cwd",
    "phases_requested",
    "phases_completed",
    "phases_total",
    "total_duration_secs",
    "phase_results",
    "post_success",
    "success"
  ],
  "$defs": {
    "ExecutionFence": {
      "description": "Complete ownership envelope for one workflow execution generation.",
      "type": "object",
      "properties": {
        "queue_lease": {
          "description": "Queue lease CAS identity. Direct execution may omit it.",
          "anyOf": [
            {
              "$ref": "#/$defs/QueueLeaseFence"
            },
            {
              "type": "null"
            }
          ]
        },
        "repository": {
          "description": "Repository/ref reservation. Non-code workflows may omit it; coding\nschedulers must require it before workspace preparation.",
          "anyOf": [
            {
              "$ref": "#/$defs/RepositoryReservation"
            },
            {
              "type": "null"
            }
          ]
        },
        "schema": {
          "description": "Stable schema id; must equal [`EXECUTION_FENCE_SCHEMA_ID`].",
          "type": "string"
        },
        "subject": {
          "description": "Subject generation, absent only for a genuinely subjectless workflow.",
          "anyOf": [
            {
              "$ref": "#/$defs/SubjectGeneration"
            },
            {
              "type": "null"
            }
          ]
        },
        "version": {
          "description": "Schema version; must equal [`EXECUTION_FENCE_VERSION`].",
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "workflow_generation": {
          "description": "Positive workflow generation. Reattachment keeps it; an intentional new\nexecution generation must increment it.",
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "workflow_id": {
          "description": "Stable workflow id. Recovery preserves this id.",
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "schema",
        "version",
        "workflow_id",
        "workflow_generation"
      ]
    },
    "PhaseEvent": {
      "description": "Event emitted by the runner during a workflow. Daemon callers receive\nthe full vector in [`WorkflowExecuteResult::phase_events`]; real-time\nstreaming is deferred to v0.6.",
      "oneOf": [
        {
          "description": "Phase started.",
          "type": "object",
          "properties": {
            "attempt": {
              "description": "Attempt number (0, 1, ...).",
              "type": "integer",
              "format": "uint32",
              "minimum": 0
            },
            "kind": {
              "type": "string",
              "const": "started"
            },
            "phase_id": {
              "description": "Phase id.",
              "type": "string"
            },
            "ts": {
              "description": "RFC 3339 timestamp.",
              "type": "string"
            }
          },
          "required": [
            "kind",
            "phase_id",
            "attempt",
            "ts"
          ]
        },
        {
          "description": "Phase recorded a decision contract verdict.",
          "type": "object",
          "properties": {
            "confidence": {
              "description": "Optional confidence score, 0.0 – 1.0.",
              "type": [
                "number",
                "null"
              ],
              "format": "float"
            },
            "kind": {
              "type": "string",
              "const": "decision"
            },
            "phase_id": {
              "description": "Phase id.",
              "type": "string"
            },
            "ts": {
              "description": "RFC 3339 timestamp.",
              "type": "string"
            },
            "verdict": {
              "description": "`\"advance\"`, `\"rework\"`, `\"skip\"`, `\"fail\"`.",
              "type": "string"
            }
          },
          "required": [
            "kind",
            "phase_id",
            "verdict",
            "ts"
          ]
        },
        {
          "description": "Phase finished with a final status.",
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "completed"
            },
            "phase_id": {
              "description": "Phase id.",
              "type": "string"
            },
            "status": {
              "description": "Status; one of [`phase_status`] values.",
              "type": "string"
            },
            "ts": {
              "description": "RFC 3339 timestamp.",
              "type": "string"
            }
          },
          "required": [
            "kind",
            "phase_id",
            "status",
            "ts"
          ]
        }
      ]
    },
    "PhaseResultSnapshot": {
      "description": "A single phase's result snapshot returned in [`WorkflowExecuteResult`].",
      "type": "object",
      "properties": {
        "close_reason": {
          "description": "Close reason if verdict was a skip / close.",
          "type": [
            "string",
            "null"
          ]
        },
        "duration_secs": {
          "description": "Duration of this phase in seconds.",
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "metadata": {
          "description": "Backend-specific metadata payload."
        },
        "next_phase_id": {
          "description": "Next phase id, if available.",
          "type": [
            "string",
            "null"
          ]
        },
        "outcome": {
          "description": "Backend-specific outcome payload."
        },
        "phase_id": {
          "description": "Phase id (workflow-local).",
          "type": "string"
        },
        "publication_receipt": {
          "description": "Receipt emitted by this phase when it is the declared publication owner.",
          "anyOf": [
            {
              "$ref": "#/$defs/PublicationReceipt"
            },
            {
              "type": "null"
            }
          ]
        },
        "status": {
          "description": "Status; one of [`phase_status`] values.",
          "type": "string"
        }
      },
      "required": [
        "phase_id",
        "status",
        "duration_secs",
        "outcome",
        "metadata"
      ]
    },
    "PublicationPullRequest": {
      "description": "Pull-request proof attached to a publication receipt.",
      "type": "object",
      "properties": {
        "head_sha": {
          "description": "Head SHA observed from the pull request provider after create/update.",
          "type": "string"
        },
        "number": {
          "description": "Repository-local pull request number.",
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "url": {
          "description": "Canonical pull request URL.",
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "number",
        "url",
        "head_sha"
      ]
    },
    "PublicationReceipt": {
      "description": "Durable proof that exactly one owner published a workflow result.\n\nCompatibility contract: v0.3+ consumers accept schema\n`animus.publication-receipt.v1`, version `1`. Unknown schema ids or versions\nfail closed. Older v0.2 consumers ignore the additive optional receipt field\non runner results, but MUST NOT be used for workflows whose publication is\nrequired because they cannot verify this proof.",
      "type": "object",
      "properties": {
        "commit_sha": {
          "description": "Commit SHA produced by the workflow.",
          "type": "string"
        },
        "issued_at": {
          "description": "UTC RFC 3339 issue timestamp.",
          "type": "string",
          "format": "date-time"
        },
        "issuer": {
          "description": "Exact owner/component that issued this receipt.",
          "$ref": "#/$defs/PublicationReceiptIssuer"
        },
        "observed_remote_sha": {
          "description": "SHA independently observed at `remote_ref` after publication.",
          "type": "string"
        },
        "pull_request": {
          "description": "Pull-request proof when the publication policy requires a PR.",
          "anyOf": [
            {
              "$ref": "#/$defs/PublicationPullRequest"
            },
            {
              "type": "null"
            }
          ]
        },
        "recovery_ref": {
          "description": "Durable ref from which unpublished/recovery work can be restored.",
          "type": "string"
        },
        "remote": {
          "description": "Canonical remote URL used for publication.",
          "type": "string"
        },
        "remote_ref": {
          "description": "Fully qualified remote ref, for example `refs/heads/animus/TASK-1173`.",
          "type": "string"
        },
        "schema": {
          "description": "Stable schema id; must equal [`PUBLICATION_RECEIPT_SCHEMA_ID`].",
          "type": "string"
        },
        "subject": {
          "description": "Qualified subject/task and its leased generation.",
          "$ref": "#/$defs/PublicationSubjectGeneration"
        },
        "tree_sha": {
          "description": "Git tree SHA for the published commit.",
          "type": "string"
        },
        "version": {
          "description": "Receipt version; must equal [`PUBLICATION_RECEIPT_VERSION`].",
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "workflow_generation": {
          "description": "Workflow generation fenced into the publication lease.",
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "workflow_id": {
          "description": "Workflow execution id.",
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "schema",
        "version",
        "workflow_id",
        "workflow_generation",
        "subject",
        "commit_sha",
        "tree_sha",
        "remote",
        "remote_ref",
        "observed_remote_sha",
        "recovery_ref",
        "issuer",
        "issued_at"
      ]
    },
    "PublicationReceiptIssuer": {
      "description": "Component that issued a publication receipt.",
      "oneOf": [
        {
          "description": "The workflow runner owns publication.",
          "type": "object",
          "properties": {
            "component": {
              "description": "Concrete runner/plugin name.",
              "type": "string"
            },
            "kind": {
              "type": "string",
              "const": "runner"
            },
            "version": {
              "description": "Concrete runner/plugin version.",
              "type": "string"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "component",
            "version"
          ]
        },
        {
          "description": "A named workflow phase owns publication.",
          "type": "object",
          "properties": {
            "component": {
              "description": "Component or command implementation that emitted the receipt.",
              "type": "string"
            },
            "kind": {
              "type": "string",
              "const": "phase"
            },
            "phase_id": {
              "description": "Phase id declared by the workflow publication contract.",
              "type": "string"
            },
            "version": {
              "description": "Concrete component/command version.",
              "type": "string"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "phase_id",
            "component",
            "version"
          ]
        }
      ]
    },
    "PublicationSubjectGeneration": {
      "description": "Qualified subject identity and generation fenced into a publication.\n\n`qualified_id` uses the canonical `<kind>:<native-id>` shape (for example\n`task:TASK-1173`). `generation` is the subject generation leased for this\nexecution; a receipt for an older generation must never satisfy a newer run.",
      "type": "object",
      "properties": {
        "generation": {
          "description": "Subject generation leased by this workflow execution.",
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "qualified_id": {
          "description": "Canonical qualified subject id.",
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "qualified_id",
        "generation"
      ]
    },
    "QueueLeaseFence": {
      "description": "Compare-and-swap identity for the queue lease currently owning a workflow.",
      "type": "object",
      "properties": {
        "entry_id": {
          "description": "Stable queue-entry id.",
          "type": "string"
        },
        "expires_at": {
          "description": "Backend-clock expiry. Expiry makes the lease recoverable, never an\nordinary fresh-leasing candidate.",
          "type": "string",
          "format": "date-time"
        },
        "generation": {
          "description": "Positive monotonic lease generation. Recovery transfers ownership by\nincrementing this value, fencing the previous daemon instance.",
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "owner_id": {
          "description": "Daemon/scheduler instance currently authorized to renew or terminalize\nthe lease.",
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "entry_id",
        "owner_id",
        "generation",
        "expires_at"
      ]
    },
    "RepositoryReservation": {
      "description": "Repository/ref ownership reserved for one execution generation.",
      "type": "object",
      "properties": {
        "base_ref": {
          "description": "Fully-qualified base ref, for example `refs/heads/main`.",
          "type": "string"
        },
        "head_ref": {
          "description": "Fully-qualified mutable head ref owned by this run, for example\n`refs/heads/animus/TASK-1175`.",
          "type": "string"
        },
        "repository": {
          "description": "Canonical repository identity. Hosts SHOULD use a normalized remote URL\nor provider `owner/name` identity and compare it case-insensitively where\nthe provider does.",
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "repository",
        "base_ref",
        "head_ref"
      ]
    },
    "SubjectGeneration": {
      "description": "A canonical subject identity and the immutable generation being executed.",
      "type": "object",
      "properties": {
        "generation": {
          "description": "Positive backend/queue generation. A later generation cannot be\nsatisfied by work or proof from an earlier one.",
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "qualified_id": {
          "description": "Canonical qualified id in `<kind>:<native-id>` form.",
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "qualified_id",
        "generation"
      ]
    }
  }
}
